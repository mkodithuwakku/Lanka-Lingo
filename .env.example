# Free practice is the default, even if keys exist in your environment.
# Leave false while practicing without paid services. No .env.local is required.
ENABLE_PAID_SERVICES=false

# Future opt-in: set ENABLE_PAID_SERVICES=true AND configure the desired provider.
OPENAI_API_KEY=

# Optional override. The default follows the model named in the current OpenAI text guide.
OPENAI_MODEL=gpt-5.6

# Optional but recommended for reliable Sinhala playback. Create an Azure Speech
# resource, then copy its key and region from the resource's Keys and Endpoint page.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=

# Optional voice override: si-LK-ThiliniNeural or si-LK-SameeraNeural.
AZURE_SPEECH_VOICE=si-LK-ThiliniNeural
